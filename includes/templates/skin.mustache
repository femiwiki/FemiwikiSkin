{{>NavigationBar}}
<input type="checkbox" id="fw-menu-checkbox" class="mw-checkbox-hack-checkbox">
<div id="fw-menu" class="fw-portals fw-wiki-portals">
  {{#data-user-menu-extended}}
  {{>Menu}}
  {{/data-user-menu-extended}}

  {{#data-sidebar}}
  {{>Menu}}
  {{/data-sidebar}}
</div>
<input type="checkbox" id="fw-toc-checkbox" class="mw-checkbox-hack-checkbox">
<div class="fw-page{{#data-page-toc}} fw-page-has-toc{{/data-page-toc}}">
  {{>Header}}
  {{#data-page-toc}}{{>TableOfContents}}{{/data-page-toc}}
  {{>Content}}
  <aside id="fw-page-aside" class="fw-page-aside"></aside>
</div>

{{#data-portlets.data-languages}}
{{>Menu}}
{{/data-portlets.data-languages}}

{{>Footer}}
