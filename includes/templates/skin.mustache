{{>NavigationBar}}
<input type="checkbox" id="fw-menu-checkbox" class="mw-checkbox-hack-checkbox">
<div id="fw-menu" class="fw-portals fw-wiki-portals">
  {{#html-account-actions}}
  <ul id="fw-account-actions">{{{.}}}</ul>
  {{/html-account-actions}}

  {{#data-user-menu-extended}}
  {{>Menu}}
  {{/data-user-menu-extended}}

  {{#data-sidebar}}
  {{>Menu}}
  {{/data-sidebar}}
</div>
<input type="checkbox" id="fw-toc-checkbox" class="mw-checkbox-hack-checkbox">
{{#data-special-nav}}
<input type="checkbox" id="fw-special-nav-checkbox" class="mw-checkbox-hack-checkbox">
{{/data-special-nav}}
<div class="fw-page{{#data-page-toc}} fw-page-has-toc{{/data-page-toc}}{{#data-special-nav}} fw-page-has-special-nav{{/data-special-nav}}">
  {{>Header}}
  {{#data-special-nav}}{{>SpecialNav}}{{/data-special-nav}}
  {{#data-page-toc}}{{>TableOfContents}}{{/data-page-toc}}
  {{>Content}}
  <aside id="fw-page-aside" class="fw-page-aside"></aside>

  {{#data-portlets.data-languages}}
  {{>Menu}}
  {{/data-portlets.data-languages}}

  {{>Footer}}
</div>
