{{#data-search-box}}
<div id="p-search" role="search" class="fw-search-box">
  {{! Shown only while the full-screen search is open on phones; leaving the input closes it }}
  <button type="button" class="fw-search-close" title="{{msg-skin-femiwiki-search-close}}" aria-label="{{msg-skin-femiwiki-search-close}}"><span class="fw-search-close-icon"></span></button>
  <div class="fw-typeahead-search-container">
    <div class="cdx-typeahead-search cdx-typeahead-search--show-thumbnail">
      <form action="{{form-action}}" id="searchform" class="cdx-search-input">
        <div id="simpleSearch" class="cdx-search-input__input-wrapper">
          <div class="cdx-text-input cdx-text-input--has-start-icon">
            {{! mw-searchInput makes core load the search module on focus }}
            <input class="cdx-text-input__input mw-searchInput" autocomplete="off" {{{html-input-attributes}}} id="searchInput">
            <span class="cdx-text-input__icon cdx-text-input__start-icon"></span>
          </div>
          <input type="hidden" name="title" value="{{page-title}}">
        </div>
      </form>
    </div>
  </div>
</div>
{{/data-search-box}}
