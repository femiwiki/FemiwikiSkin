<header id="p-header" class="fw-header">
  <div id="siteNotice" class="mw-body-content">{{{html-site-notice}}}</div>
  {{{html-user-message}}}
  <h1 id="firstHeading" class="firstHeading" {{{html-heading-language-attributes}}}>{{{html-title}}}</h1>
  <input type="checkbox" id="fw-page-menu-checkbox" class="mw-checkbox-hack-checkbox">
  <div id="p-title-buttons">
    {{#data-portlets.data-associated-pages}}{{>Menu}}{{/data-portlets.data-associated-pages}}
    <div class="right-buttons">
      {{#data-page-toc}}
      <label id="fw-toc-toggle"
        class="mw-checkbox-hack-button fw-button"
        for="fw-toc-checkbox"
        aria-controls="fw-toc"
        tabindex="0">{{msg-toc}}</label>
      {{/data-page-toc}}
      {{{html-share-button}}}
      {{>Indicator}}
      <label id="p-menu-toggle"
        class="mw-ui-icon-ellipsis mw-checkbox-hack-button fw-button"
        title="{{msg-skin-femiwiki-page-menu-tooltip}}"
        for="fw-page-menu-checkbox"
        aria-controls="p-actions-and-toolbox"
        tabindex="0"></label>
    </div>
  </div>
  <div id="p-actions-and-toolbox" class="fw-portals fw-page-portals">
    {{#data-toolbox}}{{>Menu}}{{/data-toolbox}}
    {{#data-portlets.data-actions}}{{>Menu}}{{/data-portlets.data-actions}}
  </div>
  <div id="lastmod-and-views">
    {{! VisualEditor writes the new time into #footer-info-lastmod after a save (#32). }}
    {{#html-lastmod}}
    <a id="lastmod" href="{{link-history}}"><span id="footer-info-lastmod">{{{html-lastmod}}}</span></a>
    {{/html-lastmod}}
    {{^html-lastmod}}
    {{! A link with no text is a stop for keyboard users that says nothing. }}
    <span id="footer-info-lastmod"></span>
    {{/html-lastmod}}
    {{#data-portlets.data-views}}{{>Menu}}{{/data-portlets.data-views}}
  </div>
</header>
