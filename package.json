{
	"name": "femiwiki",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"test": "npm run lint --silent",
		"lint": "npm run lint:i18n --silent && npm run lint:type --silent",
		"lint:type": "tsc",
		"lint:i18n": "banana-checker --requireLowerCase=0 i18n/",
		"selenium-daily": "npm run selenium-test",
		"selenium-test": "wdio tests/selenium/wdio.conf.js",
		"minify-svg": "svgo --config=.svgo.config.js -q -r -f resources/",
		"dev": "node dev.js && cd mediawiki && ./frankenphp php-server --listen=:2019 2>/dev/null",
		"dev-debug": "node dev.js && cd mediawiki && ./frankenphp php-server --listen=:2019 --debug"
	},
	"dependencies": {
		"@femiwiki/ooui-femiwiki-theme": "https://github.com/femiwiki/OOUIFemiwikiTheme.git#REL1_46"
	},
	"devDependencies": {
		"@types/jquery": "^4.0.1",
		"@types/node-fetch": "^3",
		"@types/unzipper": "^0.10.11",
		"@wdio/cli": "9.29.0",
		"@wdio/junit-reporter": "9.29.0",
		"@wdio/local-runner": "9.29.0",
		"@wdio/mocha-framework": "10.0.1",
		"@wdio/spec-reporter": "9.32.0",
		"@wikimedia/types-wikimedia": "^0.6.0",
		"grunt-banana-checker": "^0.13.0",
		"husky": "^9.1.7",
		"nodejs-file-downloader": "^4.13.0",
		"svgo": "^4.1.0",
		"typescript": "^7.0.2",
		"unzipper": "^0.12.3",
		"wdio-mediawiki": "6.5.3"
	}
}
